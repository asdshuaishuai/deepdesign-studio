{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deepDesign Studio",
  "version": "0.3.0",
  "identifier": "com.deepcode.deepdesign",
  "build": {
    "frontendDist": "../frontend",
    "beforeBuildCommand": "node scripts/sync-engine.mjs",
    "beforeDevCommand": "node scripts/sync-engine.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "deepDesign Studio",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
