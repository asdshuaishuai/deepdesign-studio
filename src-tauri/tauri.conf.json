{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deepDesign Studio",
  "version": "0.2.0",
  "identifier": "com.deepcode.deepdesign",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "deepDesign Studio",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}